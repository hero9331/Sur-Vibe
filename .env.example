# 이 파일을 복사해서 .env 파일을 만들고 값을 채워요. (.env는 GitHub에 올라가지 않아요)

# 서버 포트
PORT=3000

# 배포할 때만 production으로 꼭 설정해요. 내 컴퓨터에서는 비워 둬요
NODE_ENV=

# MongoDB Atlas 주소. 비워 두면 임시 메모리 DB로 실행돼요 (서버를 끄면 데이터가 사라짐)
MONGODB_URI=

# 로그인 토큰 비밀 키. 배포할 때는 길고 아무도 모르는 값으로 꼭 바꿔요
JWT_SECRET=

# 캡처 읽기에 쓰는 Claude API 키 (박영웅만 필요)
ANTHROPIC_API_KEY=
